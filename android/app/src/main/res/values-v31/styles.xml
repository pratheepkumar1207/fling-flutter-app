<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash in brand colours. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/insync_night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_symbol</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/insync_night</item>
    </style>
</resources>
