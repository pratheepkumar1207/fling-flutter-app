<?xml version="1.0" encoding="utf-8"?>
<!-- The very first moment the app opens: brand black and the insync
     splash icon (bars and wordmark), until the Flutter splash takes over. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/insync_night" />
    <item android:width="288dp" android:height="288dp" android:gravity="center">
        <bitmap android:gravity="fill" android:src="@drawable/launch_symbol" />
    </item>
</layer-list>
