<?xml version="1.0" encoding="utf-8"?>
<!-- The very first moment the app opens: night colour and the gradient
     symbol, until the Flutter splash takes over. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/insync_night" />
    <item android:width="96dp" android:height="96dp" android:gravity="center">
        <bitmap android:gravity="fill" android:src="@drawable/launch_symbol" />
    </item>
</layer-list>
